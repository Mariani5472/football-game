-- Editable, self-contained seed for the competition engine. It does not modify brasileirao.mysql.
CREATE DATABASE IF NOT EXISTS football_game CHARACTER SET utf8mb4;
USE football_game;
CREATE TABLE competition (id BIGINT PRIMARY KEY, name VARCHAR(150) NOT NULL, competition_type VARCHAR(50) NOT NULL);
CREATE TABLE competition_season (id BIGINT PRIMARY KEY, competition_id BIGINT NOT NULL, year SMALLINT NOT NULL, number_of_competitors SMALLINT NOT NULL, FOREIGN KEY (competition_id) REFERENCES competition(id));
CREATE TABLE team (id BIGINT PRIMARY KEY, name VARCHAR(150) NOT NULL);
CREATE TABLE competition_team (competition_season_id BIGINT NOT NULL, team_id BIGINT NOT NULL, PRIMARY KEY (competition_season_id, team_id), FOREIGN KEY (competition_season_id) REFERENCES competition_season(id), FOREIGN KEY (team_id) REFERENCES team(id));
CREATE TABLE competition_stage (id VARCHAR(80) PRIMARY KEY, competition_season_id BIGINT NOT NULL, name VARCHAR(150) NOT NULL, stage_order INT NOT NULL, stage_type VARCHAR(20) NOT NULL, participant_source VARCHAR(40) NOT NULL, legs TINYINT NOT NULL, points_win TINYINT NOT NULL, points_draw TINYINT NOT NULL, points_loss TINYINT NOT NULL, tie_breakers JSON NOT NULL, FOREIGN KEY (competition_season_id) REFERENCES competition_season(id));
CREATE TABLE stage_participant (stage_id VARCHAR(80) NOT NULL, team_id BIGINT NOT NULL, PRIMARY KEY (stage_id,team_id));
CREATE TABLE competition_round (id VARCHAR(100) PRIMARY KEY, stage_id VARCHAR(80) NOT NULL, round_number SMALLINT NOT NULL, UNIQUE KEY uq_round (stage_id,round_number));
CREATE TABLE fixture (id VARCHAR(100) PRIMARY KEY, stage_id VARCHAR(80) NOT NULL, round_id VARCHAR(100) NOT NULL, home_team_id BIGINT NOT NULL, away_team_id BIGINT NOT NULL, status VARCHAR(20) NOT NULL, home_goals SMALLINT NULL, away_goals SMALLINT NULL, UNIQUE KEY uq_fixture (round_id,home_team_id,away_team_id));
CREATE TABLE standing_entry (stage_id VARCHAR(80) NOT NULL, team_id BIGINT NOT NULL, played SMALLINT NOT NULL, points SMALLINT NOT NULL, wins SMALLINT NOT NULL, draws SMALLINT NOT NULL, losses SMALLINT NOT NULL, goals_for SMALLINT NOT NULL, goals_against SMALLINT NOT NULL, goal_difference SMALLINT NOT NULL, position SMALLINT NOT NULL, PRIMARY KEY (stage_id,team_id));
CREATE TABLE stage_transition (id VARCHAR(80) PRIMARY KEY, from_stage_id VARCHAR(80) NOT NULL, to_stage_id VARCHAR(80) NOT NULL, participant_source VARCHAR(40) NOT NULL);
